[Unit]
Description=Bambu Filament Controller - on-demand printer camera snapshots
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bambufc
Group=bambufc
WorkingDirectory=/opt/bambu-filament-controller
EnvironmentFile=/etc/bambu-filament-controller/controller.env
ExecStart=/opt/bambu-filament-controller/venv/bin/python /opt/bambu-filament-controller/controller/camera.py
Restart=always
RestartSec=5
UMask=0027
# Video decoding is isolated here so it can never affect heater supervision.
Nice=10
MemoryMax=512M
CPUQuota=150%

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/bambu-filament-controller
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
