# Generated by ./install.sh -- you normally don't edit these two.
# BFC_FERNET_KEY encrypts printer access codes and notification passwords in the database:
# back it up; without it, stored access codes can't be decrypted.
BFC_SECRET_KEY=
BFC_FERNET_KEY=

# Timezone for schedules and displayed times (install.sh copies your server's timezone).
BFC_TIMEZONE=
TZ=

# Port the web dashboard is published on.
BFC_PORT=8092

# Read-only printer monitoring over MQTT.
BFC_ENABLE_MQTT=true

# Master switch for anything that controls a printer (bed heater, "prepare printer" motion).
# Leave false until you have read the README's safety section. Heating additionally needs a passed
# heater test per printer.
BFC_ALLOW_HEATER_CONTROL=false

# Behind an HTTPS reverse proxy (e.g. Nginx Proxy Manager): set both of these, then only use the https:// address.
#   BFC_COOKIE_SECURE=true  -> the login cookie is only sent over HTTPS
#   BFC_PROXY_COUNT=1       -> trust the proxy's X-Forwarded-* headers (real client IP for the login throttle)
BFC_COOKIE_SECURE=false
BFC_PROXY_COUNT=0
